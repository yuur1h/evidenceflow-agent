# MODEL PROVIDER: openai, dashscope or deepseek
LLM_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-6-astra"
OPENAI_MAX_OUTPUT_TOKENS=8192
# Optional; leave blank to use the selected model's default reasoning settings.
OPENAI_REASONING_EFFORT=""
# Optional judge model override within the selected provider.
JUDGE_MODEL=""

# QWEN SETTINGS (only when LLM_PROVIDER=dashscope)
DASHSCOPE_API_KEY=""
QWEN_MODEL="qwen-max"
# Optional for hybrid thinking models: false enables direct non-thinking output.
QWEN_ENABLE_THINKING=""

# DEEPSEEK SETTINGS (only when LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=""
# deepseek-chat answers directly; deepseek-reasoner thinks first and ignores temperature.
DEEPSEEK_MODEL="deepseek-chat"
# Optional override, e.g. a proxy. Defaults to https://api.deepseek.com/v1
DEEPSEEK_BASE_URL=""

# DEEP RESEARCH SETTINGS
DEEP_RESEARCH_MEMORY_DB="data/deep_research_memory.db"
# Re-judge lexically weak citations with the model (one extra call per state at most). 0 disables.
CITATION_LLM_CHECK=1

# SERPER SETTINGS
# Optional key pool, supports comma/newline separated multiple keys
SERPER_API_KEYS=""
SERPER_API_KEY=""
IQS_API_KEY=""

# JINA SETTINGS
JINA_API_KEY=""
JINA_READER_URL="https://r.jina.ai"

# MCP SETTINGS
PLAYWRIGHT_MCP_URL=""
PLAYWRIGHT_MCP_TOKEN=""

# E2B SANDBOX SETTINGS
E2B_API_KEY=""

# SUB AGENT SETTINGS
SUB_AGENT_NUM=3
